# Copy this file to `.env` and fill in a credential:
#
#     cp .env.example .env
#
# `.env` is gitignored; this template is not. The harness reads `.env` at import, and a
# real environment variable always takes precedence over anything set here — so what is
# exported is always what is in effect.
#
# None of this is needed for `--mock`, which exercises the entire loop with no
# credential and no network:
#
#     ./.venv/bin/python -m harness.loop --mock --max-iters 5

# ---------------------------------------------------------------- credential
# One of these. The first is what an ordinary Anthropic API key uses.

ANTHROPIC_API_KEY=sk-ant-...

# A bearer-token credential instead, as most gateways issue:
# HARNESS_LLM_AUTH_TOKEN=...

# ---------------------------------------------------------------- endpoint
# Only if you are going through a gateway rather than Anthropic directly.
#
# The endpoint must speak the Anthropic Messages API. That is a hard requirement, not a
# preference: the run places a `cache_control` breakpoint with a 1-hour TTL and reads
# its token accounting -- a graded deliverable -- off the `usage` fields. A proxy that
# merely translates to an OpenAI-shaped API does not error; it silently drops the cache
# directives, and the only symptom is the bill.
#
# HARNESS_LLM_BASE_URL=https://your-gateway.example/anthropic

# If the gateway names the model differently:
# HARNESS_LLM_MODEL=claude-opus-5
