# Dataset: 200MB extracted, reproducible via scripts/get_data.sh
kuairand-starter-kit/KuaiRand-Pure/
kuairand-starter-kit/*.tar.gz

# Derived artifacts, rebuilt by `python -m harness.preflight`
cache/
runs/

# Secrets. Never commit; check history too, not just the tree.
.env
*.key

# Environment
.venv/
__pycache__/
*.py[cod]
.DS_Store

# Mock-mode rehearsal output. Not a deliverable: mock runs prove the plumbing, and
# committing their candidates would put scripts the agent never wrote next to ones it
# did.
outputs/mock/
logs/mock_*

# Scratch
harness_design.html
